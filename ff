import { audioManager } from './audio/audioManager';
import { sceneManager } from './ui/SceneManager';
import { loadMap } from './game/map/map';
import { gameLoop } from './game/gameLoop';

let gameLoopRunning = false;
let animationFrameId: number | null = null;

async function init() {
  // Précharger l'audio
  await audioManager.preloadSounds();
  await audioManager.preloadMusic();
  
  // Configurer les boutons du menu
  setupMenuButtons();
  setupOptionsButtons();
  
  // Démarrer sur le menu principal
  sceneManager.switchTo('menu');
}

function setupMenuButtons() {
  document.getElementById('btn-new-game')!.addEventListener('click', () => {
    audioManager.playSound('ui_click');
    startNewGame();
  });
  
  document.getElementById('btn-continue')!.addEventListener('click', () => {
    audioManager.playSound('ui_click');
    continueGame();
  });
  
  document.getElementById('btn-options')!.addEventListener('click', () => {
    audioManager.playSound('ui_click');
    sceneManager.switchTo('options');
  });
}

function setupOptionsButtons() {
  // Volume master
  document.getElementById('volume-master')!.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).valueAsNumber / 100;
    audioManager.setMasterVolume(value);
  });
  
  // Volume musique
  document.getElementById('volume-music')!.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).valueAsNumber / 100;
    audioManager.setMusicVolume(value);
  });
  
  // Volume SFX
  document.getElementById('volume-sfx')!.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).valueAsNumber / 100;
    audioManager.setSfxVolume(value);
  });
  
  // Retour
  document.getElementById('btn-back')!.addEventListener('click', () => {
    audioManager.playSound('ui_click');
    sceneManager.goBack();
  });
}

function startNewGame() {
  sceneManager.switchTo('game');
  
  // Réinitialiser le jeu
  stateDungeon.currentFloor = 0;
  statePlayer.stat.hp = statePlayer.stat.maxHp;
  
  loadMap();
  startGameLoop();
}

function continueGame() {
  sceneManager.switchTo('game');
  // Charger la sauvegarde
  loadSavedGame();
  startGameLoop();
}

function startGameLoop() {
  if (gameLoopRunning) return;
  gameLoopRunning = true;
  
  function loop() {
    gameLoop(); // Votre game loop actuelle
    
    if (gameLoopRunning) {
      animationFrameId = requestAnimationFrame(loop);
    }
  }
  
  loop();
}

function stopGameLoop() {
  gameLoopRunning = false;
  if (animationFrameId !== null) {
    cancelAnimationFrame(animationFrameId);
    animationFrameId = null;
  }
}

// Pause
window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && sceneManager.getCurrentScene() === 'game') {
    audioManager.playSound('ui_click');
    pauseGame();
  }
});

function pauseGame() {
  stopGameLoop();
  sceneManager.switchTo('pause');
  
  document.getElementById('btn-resume')!.addEventListener('click', () => {
    audioManager.playSound('ui_click');
    resumeGame();
  });
}

function resumeGame() {
  sceneManager.switchTo('game');
  startGameLoop();
}

// Démarrer l'application
init();
```

